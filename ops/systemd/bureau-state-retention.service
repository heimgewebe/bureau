[Unit]
Description=Bureau local retention after verified StateStore restore proof
Documentation=https://github.com/heimgewebe/bureau/blob/main/docs/operations.md
ConditionPathIsDirectory=%h/artifacts/merges/bureau-state-backups
ConditionPathExists=%h/.local/bin/bureau

[Service]
Type=oneshot
ExecStart=%h/.local/bin/bureau state-retention --backup-root %h/artifacts/merges/bureau-state-backups
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/.local/share/bureau
ReadWritePaths=%h/artifacts/merges/bureau-state-backups %h/.local/share/bureau/registry-snapshots
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
