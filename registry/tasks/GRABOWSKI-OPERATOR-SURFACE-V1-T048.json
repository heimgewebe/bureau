    "GRABOWSKI-OPERATOR-SURFACE-V1-T040"
  ],
  "acceptance": [
    {
      "id": "delivery-before-merge",
      "assertion": "A nontrivial merge is authorized only by a durable delivery receipt proving that the complete downloadable diff artifact was exposed to the user before merge dispatch; artifact creation alone is insufficient."
    },
    {
      "id": "head-and-diff-binding",
      "assertion": "The delivery receipt, critical review and merge request bind the same repository, pull request, exact head SHA and complete GitHub diff SHA-256; any head change invalidates all three and requires regeneration and redelivery."
    },
    {
      "id": "parallel-merge-serialization",
      "assertion": "A merge-intent resource or equivalent atomic gate prevents another cooperating Grabowski actor from merging the same pull request while artifact delivery or review is pending."
    },
    {
      "id": "external-merge-reconciliation",
      "assertion": "If GitHub shows that another actor already merged, the operation performs no duplicate effect, records whether the pre-merge delivery contract was satisfied and never treats post-merge exposure as equivalent evidence."
    },
    {
      "id": "observable-timestamps",
      "assertion": "Receipts expose artifact creation time, user-visible delivery time, merge-dispatch time and GitHub merge time in a comparable clock domain, with ordering uncertainty stated explicitly."
    },
    {
      "id": "tests",
      "assertion": "Tests cover two concurrent merge actors, head drift after delivery, delivery failure, already-merged reconciliation, stale receipts and an exact successful artifact-review-delivery-merge sequence."
    },
    {
      "id": "non-authority",
      "assertion": "The gate grants no merge authority by itself and cannot replace task authorization, CI, critical review, recovery, branch protection or human authorization requirements."
    }
  ],
