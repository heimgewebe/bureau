[Unit]
Description=Bureau automation PR bridge
Documentation=https://github.com/heimgewebe/bureau
ConditionPathIsDirectory=%h/repos/bureau
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/bureau source-pr-bridge
ExecStart=%h/.local/bin/bureau source-pr-bridge --kind now-refill --auto-merge --publish --root %h/repos/bureau --state-root %h/.local/state/bureau --authority bureau-source-pr-bridge-local
Environment=GH_HOST=github.com
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/repos/bureau %h/.local/state/bureau
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
UMask=0077
TimeoutStartSec=300
