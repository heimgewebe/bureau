[Unit]
Description=Bureau isolated StateStore restore verification
Documentation=https://github.com/heimgewebe/bureau/blob/main/docs/operations.md
ConditionFileIsExecutable=%h/.local/bin/bureau
ConditionPathIsDirectory=%h/.local/state/bureau-backup
ConditionFileNotEmpty=%h/.local/state/grabowski/resources.sqlite3

[Service]
Type=oneshot
ExecStart=%h/.local/bin/bureau --json state-backup restore-test --backup-root %h/.local/state/bureau-backup --grabowski-resource-db %h/.local/state/grabowski/resources.sqlite3
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/.local/state/bureau-backup %h/.local/state/grabowski/resources.sqlite3
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
