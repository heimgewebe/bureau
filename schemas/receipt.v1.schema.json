{
  "$defs": {
    "reposkop_checkout_ref": {
      "$defs": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "continuity_sha256": {
                "$ref": "#/$defs/reposkop_checkout_ref/$defs/sha256"
              },
              "post_observation_sha256": {
                "$ref": "#/$defs/reposkop_checkout_ref/$defs/sha256"
              },
              "transition_sha256": {
                "$ref": "#/$defs/reposkop_checkout_ref/$defs/sha256"
              }
            },
            "required": [
              "post_observation_sha256",
              "transition_sha256",
              "continuity_sha256"
            ]
          },
          "if": {
            "properties": {
              "continuity_state": {
                "const": "pre_effect_only"
              }
            },
            "required": [
              "continuity_state"
            ]
          },
          "then": {
            "required": [
              "post_observation_sha256",
              "transition_sha256",
              "continuity_sha256"
            ],
            "properties": {
              "continuity_sha256": {
                "type": "null"
              },
              "post_observation_sha256": {
                "type": "null"
              },
              "transition_sha256": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "captured_at": {
          "format": "date-time",
          "type": "string"
        },
        "checkout_identity_sha256": {
          "$ref": "#/$defs/reposkop_checkout_ref/$defs/sha256"
        },
        "continuity_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/reposkop_checkout_ref/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "continuity_state": {
          "enum": [
            "pre_effect_only",
            "intact",
            "explainable_drift",
            "identity_break",
            "inconclusive"
          ]
        },
        "does_not_establish": {
          "allOf": [
            {
              "contains": {
                "const": "task_completion"
              }
            },
            {
              "contains": {
                "const": "effect_authorization"
              }
            }
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "post_observation_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/reposkop_checkout_ref/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "pre_observation_sha256": {
          "$ref": "#/$defs/reposkop_checkout_ref/$defs/sha256"
        },
        "producer": {
          "const": "reposkop"
        },
        "purpose": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "repository_identity_sha256": {
          "$ref": "#/$defs/reposkop_checkout_ref/$defs/sha256"
        },
        "schema_version": {
          "const": 1
        },
        "transition_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/reposkop_checkout_ref/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "producer",
        "repository",
        "purpose",
        "pre_observation_sha256",
        "repository_identity_sha256",
        "checkout_identity_sha256",
        "continuity_state",
        "does_not_establish"
      ],
      "type": "object"
    },
    "rlens_context_ref": {
      "additionalProperties": false,
      "properties": {
        "bundle_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": [
            "string",
            "null"
          ]
        },
        "does_not_establish": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "freshness_status": {
          "enum": [
            "fresh_exact",
            "fresh_dirty_unverified",
            "stale_head",
            "unknown",
            "not_required"
          ]
        },
        "generated_at": {
          "format": "date-time",
          "type": "string"
        },
        "live_commit_at_claim": {
          "pattern": "^[0-9a-f]{40}$",
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "preflight_status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "not_applicable",
            "unknown"
          ]
        },
        "repo": {
          "pattern": "^[A-Za-z0-9_.-]{1,120}$",
          "type": "string"
        },
        "schema_version": {
          "const": 1
        },
        "source": {
          "minLength": 1,
          "type": "string"
        },
        "stem": {
          "pattern": "^[A-Za-z0-9_.-]{1,160}$",
          "type": "string"
        },
        "task_profile": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "repo",
        "stem",
        "manifest_sha256",
        "freshness_status",
        "task_profile",
        "preflight_status"
      ],
      "type": "object"
    },
    "rlens_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "opportunistic",
            "required",
            "strict",
            "live-first",
            "external-safe"
          ]
        },
        "task_profile": {
          "type": "string",
          "minLength": 1
        },
        "skip_reason": {
          "type": "string",
          "enum": [
            "not_required",
            "live_first_primary",
            "context_pack_unavailable",
            "stale_context_explicitly_allowed",
            "external_safe_export_blocked",
            "trivial_task",
            "not_yet_generated",
            "policy_override"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mode"
      ]
    },
    "rlens_policy_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "opportunistic",
            "required",
            "strict",
            "live-first",
            "external-safe"
          ]
        },
        "requires_context": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "satisfied",
            "skipped",
            "blocked",
            "not_required"
          ]
        },
        "task_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "has_context_ref": {
          "type": "boolean"
        },
        "skip_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "not_required",
            "live_first_primary",
            "context_pack_unavailable",
            "stale_context_explicitly_allowed",
            "external_safe_export_blocked",
            "trivial_task",
            "not_yet_generated",
            "policy_override",
            null
          ]
        },
        "block_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "does_not_establish": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "mode",
        "requires_context",
        "status",
        "has_context_ref",
        "skip_reason",
        "block_reason",
        "does_not_establish"
      ]
    }
  },
  "$id": "https://heimgewebe.local/bureau/receipt.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "envelope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "evidence": {
      "minProperties": 1,
      "properties": {
        "reposkop_checkout_ref": {
          "$ref": "#/$defs/reposkop_checkout_ref"
        }
      },
      "type": "object"
    },
    "external": {
      "type": [
        "object",
        "null"
      ]
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "rlens_context_ref": {
      "$ref": "#/$defs/rlens_context_ref"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string"
    },
    "task_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "verified_at": {
      "format": "date-time",
      "type": "string"
    },
    "rlens_context_policy": {
      "$ref": "#/$defs/rlens_policy_evaluation"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "task_sha256",
    "plan_sha256",
    "envelope_sha256",
    "verified_at",
    "external",
    "evidence",
    "receipt_sha256"
  ],
  "title": "Bureau receipt v1",
  "type": "object"
}
